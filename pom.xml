<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- The settings of the build (Java version, formatting, versions of libraries) are the core's:
       build the core first with './mvnw install' in ../Praksis. -->
  <parent>
    <groupId>it.uhde</groupId>
    <artifactId>praksis-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath/>
  </parent>

  <artifactId>praksis-mcp</artifactId>
  <name>Praksis MCP</name>
  <description>An MCP server for the Praksis daemon: tools for an agent, with no rights of its own.</description>

  <properties>
    <mcp.version>2.1.0</mcp.version>
    <slf4j.version>2.0.17</slf4j.version>
    <praksis.image>${project.basedir}/../Praksis/praksis-dist/target/praksis</praksis.image>
  </properties>

  <dependencies>
    <dependency>
      <groupId>it.uhde</groupId>
      <artifactId>praksis-protocol</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.modelcontextprotocol.sdk</groupId>
      <artifactId>mcp-core</artifactId>
      <version>${mcp.version}</version>
    </dependency>
    <!-- Jackson 2, as the rest of Praksis; the SDK also offers Jackson 3 -->
    <dependency>
      <groupId>io.modelcontextprotocol.sdk</groupId>
      <artifactId>mcp-json-jackson2</artifactId>
      <version>${mcp.version}</version>
    </dependency>
    <!-- stdout belongs to the protocol: all logging goes to stderr -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>${slf4j.version}</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- The integration tests run the real daemon of the core: build its runtime image first
           ('./mvnw package' in ../Praksis), or point praksis.image at one. Without an image they
           are skipped, and say so. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <systemPropertyVariables>
            <praksis.image>${praksis.image}</praksis.image>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <!-- one runnable jar: java -jar target/praksis-mcp.jar -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <finalName>praksis-mcp</finalName>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>it.uhde.praksis.mcp.Main</mainClass>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>META-INF/MANIFEST.MF</exclude>
                    <exclude>module-info.class</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
